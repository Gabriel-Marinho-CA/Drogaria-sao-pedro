{
  "store.search": {
    "blocks": [
      "search-result-layout"
    ],
    "props": {
      "context": {
        "skusFilter": "ALL",
        "simulationBehavior": "skip"
      }
    }
  },
  "store.search#brand": {
    "blocks": [
      "search-result-layout"
    ],
    "props": {
      "context": {
        "orderByField": "OrderByReleaseDateDESC",
        "hideUnavailableItems": true,
        "maxItemsPerPage": 10,
        "skusFilter": "ALL",
        "simulationBehavior": "skip"
      }
    }
  },
  "store.search#department": {
    "blocks": [
      "search-result-layout"
    ],
    "props": {
      "context": {
        "skusFilter": "ALL",
        "simulationBehavior": "skip"
      }
    }
  },
  "store.search#category": {
    "blocks": [
      "search-result-layout"
    ],
    "props": {
      "context": {
        "skusFilter": "ALL",
        "simulationBehavior": "skip"
      }
    }
  },
  "store.search#subcategory": {
    "blocks": [
      "search-result-layout"
    ],
    "props": {
      "context": {
        "skusFilter": "ALL",
        "simulationBehavior": "skip"
      }
    }
  },
  "search-result-layout": {
    "blocks": [
      "search-result-layout.desktop",
      "search-result-layout.mobile",
      "search-not-found-layout"
    ]
  },
  "search-result-layout.desktop": {
    "children": [
      "flex-layout.row#searchbread",
      "flex-layout.row#searchtitle",
      "flex-layout.row#searchdescription",
      "flex-layout.row#result"
    ],
    "props": {
      "pagination": "show-more",
      "preventRouteChange": false,
      "defaultGalleryLayout": "grid"
    }
  },
  "flex-layout.row#searchbread": {
    "title": "Linha - Breadcrumb",
    "children": [
      "breadcrumb.search"
    ],
    "props": {
      "blockClass": "searchBread",
      "preserveLayoutOnMobile": true,
      "fullWidth": true
    }
  },
  "flex-layout.row#searchtitle": {
    "props": {
      "blockClass": "searchTitleRow"
    },
    "children": [
      "search-title.v2"
    ]
  },
  /* Texto descritivo exclusivo de cada categoria/coleção.
   * O bloco fica vazio no tema de propósito: o conteúdo é preenchido pelo
   * Site Editor página a página (Categoria > escolher a página > este bloco),
   * então cada categoria/coleção guarda o seu próprio texto.
   * Como desktop e mobile apontam para o mesmo `rich-text#category-description`,
   * o texto é editado uma única vez e aparece nos dois layouts.
   * Estilo (Roboto 18px/24px, #242424, espaçamentos) fica por conta do dev
   * através do handle gerado por `blockClass: "categoryDescription"`.
   *
   * O rótulo e o formulário que o admin vê no Site Editor vêm de
   * `store/contentSchemas.json` — sem ele o bloco aparece como "rich-text"
   * genérico e não dá para saber que é a descrição da categoria. */
  "flex-layout.row#searchdescription": {
    "title": "Linha - Descrição da Categoria",
    "children": [
      "rich-text#category-description"
    ],
    "props": {
      "blockClass": "categoryDescriptionRow",
      "preserveLayoutOnMobile": true
    }
  },
  "rich-text#category-description": {
    "props": {
      "title": "Texto - Descrição da Categoria",
      "text": "",
      "textAlignment": "LEFT",
      "textPosition": "LEFT",
      "blockClass": "categoryDescription"
    }
  },
  "flex-layout.row#result": {
    "children": [
      "flex-layout.col#filter",
      "flex-layout.col#content"
    ],
    "props": {
      "preventHorizontalStretch": true,
      "fullWidth": true,
          "blockClass":"search--info--wrapper"
    }
  },
  "flex-layout.col#filter": {
    "children": [
      "filter-navigator.v3"
    ],
    "props": {
      "blockClass": "filterCol"
    }
  },
  /* No layout todos os filtros aparecem fechados, como caixas de 52px.
   * `initiallyCollapsed` é prop do bloco — sem ele o padrão é abrir todos e
   * nenhum CSS resolve, porque o estado vem do React.
   *
   * `navigationTypeOnMobile: "collapsible"` troca a navegação da gaveta mobile:
   * o padrão ("page") substitui a lista pela tela do filtro escolhido (aquele
   * efeito de "passar para o lado"); com "collapsible" cada filtro abre um
   * accordion no lugar, um embaixo do outro, igual ao desktop. */
  "filter-navigator.v3": {
    /* `blocks` e não `children`: a interface do filter-navigator.v3 declara
     * composição `blocks`, e usar `children` quebra o build com
     * "Composition mismatch". */
    "blocks": [
      "sidebar-close-button"
    ],
    "props": {
      "title": "Filtros",
      "initiallyCollapsed": true,
      "openFiltersMode": "many",
      "navigationTypeOnMobile": "collapsible"
    }
  },
  /* O "X" do layout. O FilterSidebar já tem o ExtensionPoint
   * `sidebar-close-button`, mas ele só renderiza se o bloco for declarado como
   * filho do filter-navigator — por isso a gaveta estava sem botão de fechar.
   * O componente se posiciona sozinho (`absolute top-0 right-0`). */
  "sidebar-close-button": {
    "props": {
      "size": 16,
      "type": "line"
    }
  },
  "flex-layout.col#content": {
    "children": [
      "flex-layout.row#searchinfo",
      "flex-layout.row#fetchprevious",
      "flex-layout.row#products",
      "flex-layout.row#fetchmore"
    ],
    "props": {
      "width": "grow",
      "preventVerticalStretch": true,
      "blockClass":"search--info"
    }
  },
  "flex-layout.row#searchinfo": {
    "title": "Linha - Ordenar e Organizar",
    "children": [
      "flex-layout.col#orderBy",
      "flex-layout.row#organizar"
    ],
    "props": {
      "blockClass": "searchInfo",
      "verticalAlign": "middle"
    }
  },
  "flex-layout.col#orderBy": {
    "children": [
      "order-by.v2"
    ],
    "props": {
      "blockClass": "orderByCol"
    }
  },
  "flex-layout.row#organizar": {
    "title": "Grupo - Organizar",
    "children": [
      "rich-text#organizar",
      "gallery-layout-switcher"
    ],
    "props": {
      "blockClass": "organizar",
      "preventHorizontalStretch": true,
      "horizontalAlign": "right",
      "verticalAlign": "middle",
      "colGap": 3
    }
  },
  "rich-text#organizar": {
    "props": {
      "title": "Texto - Organizar",
      "text": "Organizar",
      "blockClass": "organizarLabel"
    }
  },
  "flex-layout.row#fetchprevious": {
    "props": {
      "marginBottom": 3
    },
    "children": [
      "search-fetch-previous"
    ]
  },
  "flex-layout.row#fetchmore": {
    "props": {
      "marginTop": 3
    },
    "children": [
      "search-fetch-more"
    ]
  },
  "search-fetch-previous": {
    "props": {
      "htmlElementForButton": "a"
    }
  },
  "search-fetch-more": {
    "props": {
      "htmlElementForButton": "a"
    }
  },
  "flex-layout.row#products": {
    "children": [
      "search-content"
    ]
  },
  "search-content": {
    "blocks": [
      "gallery",
      "not-found"
    ]
  },
  "search-result-layout.mobile": {
    /* Mesma ordem do desktop: breadcrumb, título, descrição e só então as
     * ações. `searchtitle` e `searchdescription` são os MESMOS blocos usados no
     * desktop, então o conteúdo é idêntico sem duplicar configuração. */
    "children": [
      "flex-layout.row#searchbread",
      "flex-layout.row#searchtitle",
      "flex-layout.row#searchdescription",
      "flex-layout.row#searchinfomobile",
      "flex-layout.row#fetchprevious",
      "flex-layout.row#contentmobile",
      "flex-layout.row#fetchmore"
    ],
    "props": {
      "pagination": "show-more",
      "mobileLayout": {
        "mode1": "small",
        "mode2": "normal"
      },
      "defaultGalleryLayout": "grid"
    }
  },
  "flex-layout.row#contentmobile": {
    "children": [
      "search-content"
    ],
    "props": {
      "preserveLayoutOnMobile": true,
      "blockClass":"content-wrapper-mobile"
    }
  },
  /* No layout mobile a linha tem só dois controles, nessa ordem: "Filtros" e
   * "Ordenar Por". O `gallery-layout-switcher` saiu — ver observação na
   * entrega; para voltar, basta reincluir "flex-layout.col#switcherMobile". */
  "flex-layout.row#searchinfomobile": {
    "title": "Linha - Filtros e Ordenar (mobile)",
    "children": [
      "flex-layout.col#filterMobile",
      "flex-layout.col#orderByMobile"
    ],
    "props": {
      "blockClass": "searchInfoMobile",
      "preserveLayoutOnMobile": true,
      "colSizing": "auto"
    }
  },
  "flex-layout.col#orderByMobile": {
    "children": [
      "order-by.v2"
    ],
    "props": {
      "blockClass": "orderByMobileCol"
    }
  },
  "flex-layout.col#filterMobile": {
    "children": [
      "filter-navigator.v3"
    ],
    "props": {
      "blockClass": "filterMobileCol"
    }
  },
  "flex-layout.col#switcherMobile": {
    "children": [
      "gallery-layout-switcher"
    ],
    "props": {
      "verticalAlign": "middle"
    }
  },
  "search-not-found-layout": {
    "children": [
      "flex-layout.row#searchbread",
      "flex-layout.row#notfound"
    ]
  },
  "flex-layout.row#notfound": {
    "children": [
      "not-found"
    ],
    "props": {
      "fullWidth": true
    }
  },
  /* `showOnMobile` precisa estar no MESMO bloco que é renderizado
   * (`breadcrumb.search`, usado em `flex-layout.row#searchbread`). Sem ele o
   * vtex.breadcrumb aplica `dn db-ns` no container e o breadcrumb some no
   * mobile. Manter também em `breadcrumb` para qualquer uso do bloco base. */
  "breadcrumb.search": {
    "props": {
      "showOnMobile": true
    }
  },
  "breadcrumb": {
    "props": {
      "showOnMobile": true
    }
  },
  "gallery": {
    "props": {
      "layouts": [
        {
          "name": "grid",
          "component": "GridSummary",
          "itemsPerRow": {
            "(min-width:1300px)": 4,
            "desktop": 3,
            "tablet": 3,
            "phone": 2
          }
        },
        {
          "name": "list",
          "component": "ListSummary",
          "itemsPerRow": 1
        }
      ],
      "ListSummary": "product-summary.shelf#listLayout",
      "GridSummary": "product-summary.shelf"
    }
  },
  "gallery-layout-switcher": {
    "children": [
      /*
       * For accessbility to work properly,
       * It's important to define the options in the same order as the layouts
       */
      "gallery-layout-option#grid",
      "gallery-layout-option#list"
    ]
  },
  "gallery-layout-option#grid": {
    "props": {
      "name": "grid"
    },
    "children": [
      "icon-grid"
    ]
  },
  "gallery-layout-option#list": {
    "props": {
      "name": "list"
    },
    "children": [
      "icon-inline-grid"
    ]
  } 
}