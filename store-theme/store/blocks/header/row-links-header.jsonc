{
  // =============================================
  // ROW LINKS — barra abaixo do sticky header
  // =============================================
  "flex-layout.row#row-links": {
    "title": "Links Header",
    "props": {
      "blockClass": "row-links",
      "fullWidth": false,
      "stretchChildrenWidth": true,
      "horizontalAlign": "center",
      "preventVerticalStretch": false
    },
    "children": [
      "flex-layout.col#col-departamentos",
      "flex-layout.col#col-menu-links",
      "flex-layout.col#col-extras"
    ]
  },
  // =============================================
  // COL DEPARTAMENTOS (1/3)
  // =============================================
  "flex-layout.col#col-departamentos": {
    "props": {
      "blockClass": "col-departamentos"
    },
    "children": [
      "vtex.menu@2.x:menu#menu-departamentos"
    ]
  },
  "vtex.menu@2.x:menu#menu-departamentos": {
    "children": [
      "menu-item#trigger-toda-loja"
    ],
    "props": {
      "blockClass": "menu-departamentos"
    }
  },
  /* Item "Toda Loja" é apenas um trigger (abre submenu, sem link próprio).

     NÃO voltar o id para menu-item#trigger-departamentos. O conteúdo salvo
     no Site Editor para aquele id tinha `onMountBehavior: "open"`, e
     conteúdo do Site Editor ganha das props daqui: o dropdown já vinha
     aberto do servidor a cada F5 e só fechava depois do primeiro hover.
     Trocar o id desliga aquele conteúdo; o texto "Toda Loja", que era a
     única outra coisa útil nele, foi trazido para cá.

     Se alguém editar este item pelo Site Editor, conferir que o
     comportamento ao carregar continua FECHADO — os itens salvos por lá
     vieram todos com "open". O blockClass continua trigger-departamentos
     porque é nele que o CSS se apoia. */
  "menu-item#trigger-toda-loja": {
    "blocks": [
      "vtex.menu@2.x:submenu#main-menu-departments"
    ],
    "props": {
      "type": "custom",
      "blockClass": "trigger-departamentos",
      "onMountBehavior": "closed",
      "itemProps": {
        "type": "internal",
        "href": "#",
        "text": "Toda Loja",
        "tagTitle": "Toda a Loja"
      }
    }
  },
  "vtex.menu@2.x:submenu#main-menu-departments": {
    "props": {
      "blockClass": "main-menu-departments"
    },
    "children": [
      "menu-item#dep-infantil",
      "menu-item#dep-dermocosmeticos",
      "menu-item#dep-saude-bem-estar",
      "menu-item#dep-beleza-cuidados",
      "menu-item#dep-medicamentos",
      "menu-item#dep-infantil",
      "menu-item#dep-dermocosmeticos",
      "menu-item#dep-saude-bem-estar",
      "menu-item#dep-beleza-cuidados",
      "menu-item#dep-medicamentos"
    ]
  },
  "menu-item#dep-infantil": {
    "props": {
      "id": "menu-item-dep-infantil",
      "blockClass": "dep-infantil",
      "type": "custom",
      "itemProps": {
        "type": "internal",
        "href": "/infantil",
        "text": "Infantil",
        "tagTitle": "Infantil"
      }
    }
  },
  "menu-item#dep-dermocosmeticos": {
    "props": {
      "id": "menu-item-dep-dermocosmeticos",
      "blockClass": "dep-dermocosmeticos",
      "type": "custom",
      "itemProps": {
        "type": "internal",
        "href": "/dermocosmeticos",
        "text": "Dermocosméticos",
        "tagTitle": "Dermocosméticos"
      }
    }
  },
  "menu-item#dep-saude-bem-estar": {
    "props": {
      "id": "menu-item-dep-saude-bem-estar",
      "blockClass": "dep-saude-bem-estar",
      "type": "custom",
      "itemProps": {
        "type": "internal",
        "href": "/saude-e-bem-estar",
        "text": "Saúde e Bem Estar",
        "tagTitle": "Saúde e Bem Estar"
      }
    }
  },
  "menu-item#dep-beleza-cuidados": {
    "props": {
      "id": "menu-item-dep-beleza-cuidados",
      "blockClass": "dep-beleza-cuidados",
      "type": "custom",
      "itemProps": {
        "type": "internal",
        "href": "/beleza-e-cuidados",
        "text": "Beleza e Cuidados",
        "tagTitle": "Beleza e Cuidados"
      }
    }
  },
  // Medicamentos tem link próprio + submenu de subcategorias
  "menu-item#dep-medicamentos": {
    "blocks": [
      "vtex.menu@2.x:submenu#submenu--children"
    ],
    "props": {
      "id": "menu-item-dep-medicamentos",
      "blockClass": "dep-medicamentos",
      "type": "custom",
      "itemProps": {
        "type": "internal",
        "href": "/medicamentos",
        "text": "Medicamentos",
        "tagTitle": "Medicamentos"
      }
    }
  },
  "vtex.menu@2.x:submenu#submenu--children": {
    "props": {
      "blockClass":"submenu--children"
    },
    "children": [
      "menu-item#sub-remedios-cardiologicos",
      "menu-item#sub-mais-medicamentos",
      "menu-item#sub-antigripais",
      "menu-item#sub-saude-dos-olhos",
      "menu-item#sub-remedios-cardiologicos",
      "menu-item#sub-mais-medicamentos",
      "menu-item#sub-antigripais",
      "menu-item#sub-saude-dos-olhos"
    ]
  },
  "menu-item#sub-remedios-cardiologicos": {
    "props": {
      "id": "menu-item-sub-remedios-cardiologicos",
      "type": "custom",
      "itemProps": {
        "type": "internal",
        "href": "/medicamentos/remedios-cardiologicos",
        "text": "Remédios Cardiológicos",
        "tagTitle": "Remédios Cardiológicos"
      }
    }
  },
  "menu-item#sub-mais-medicamentos": {
    "props": {
      "id": "menu-item-sub-mais-medicamentos",
      "type": "custom",
      "itemProps": {
        "type": "internal",
        "href": "/medicamentos/mais-medicamentos",
        "text": "Mais Medicamentos",
        "tagTitle": "Mais Medicamentos"
      }
    }
  },
  "menu-item#sub-antigripais": {
    "props": {
      "id": "menu-item-sub-antigripais",
      "type": "custom",
      "itemProps": {
        "type": "internal",
        "href": "/medicamentos/antigripais",
        "text": "Antigripais",
        "tagTitle": "Antigripais"
      }
    }
  },
  "menu-item#sub-saude-dos-olhos": {
    "props": {
      "id": "menu-item-sub-saude-dos-olhos",
      "type": "custom",
      "itemProps": {
        "type": "internal",
        "href": "/medicamentos/saude-dos-olhos",
        "text": "Saúde dos Olhos",
        "tagTitle": "Saúde dos Olhos"
      }
    }
  },
  // =============================================
  // COL MENU LINKS (2/3) — menu horizontal
  // =============================================
  "flex-layout.col#col-menu-links": {
    "props": {
      "blockClass": "col-menu-links"
    },
    "children": [
      "vtex.menu@2.x:menu#mega-menu-bar"
    ]
  },
  /* Cada menu-item abaixo abre um mega menu no hover (subcategorias +
     banner). Os menu-item#link-* e os painéis estão em
     store/blocks/header/mega-menu/ — um arquivo por departamento.
     No Site Editor: Links Header > Menu (o segundo) > <departamento> >
     Mega menu - <departamento> > Coluna 1..3 / Banner.

     Para um departamento novo, crie o arquivo na pasta e inclua o
     menu-item aqui — não pela lista "items" do Site Editor, que vira só
     um link solto, sem painel.

     NÃO voltar o id para menu#menu-links-row. O conteúdo salvo no Site
     Editor para aquele id tinha um "Infantil" solto (sem mega menu) e
     dois itens vazios na lista `items`; trocar o id desliga esse
     conteúdo. O blockClass continua menu-links-row porque o CSS usa. */
  "vtex.menu@2.x:menu#mega-menu-bar": {
    "children": [
      "menu-item#link-medicamentos",
      "menu-item#link-saude",
      "menu-item#link-beleza",
      "menu-item#link-dermocosmeticos",
      "menu-item#link-infantil"
    ],
    "props": {
      "orientation": "horizontal",
      "blockClass": "menu-links-row",
      // o painel só monta quando abre (mesma escolha do Minas Mais)
      "experimentalOptimizeRendering": true
    }
  },
  // =============================================
  // COL EXTRAS (3/3) — links utilitários
  // =============================================
  "flex-layout.col#col-extras": {
    "props": {
      "blockClass": "col-extras"
    },
    "children": [
      "rich-text#baixe-o-app",
      "rich-text#ajuda"
    ]
  },
  "rich-text#baixe-o-app": {
    "props": {
      "blockClass": "baixe-o-app",
      "text": "[Baixe o app](#)",
      "textPosition": "LEFT",
      "textAlignment": "LEFT"
    }
  },
  "rich-text#ajuda": {
    "props": {
      "blockClass": "ajuda",
      "text": "[Ajuda](#)",
      "textPosition": "LEFT",
      "textAlignment": "LEFT"
    }
  }
}