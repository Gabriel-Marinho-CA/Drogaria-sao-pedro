{
  "flex-layout.col#footer-security": {
    "props": {
      "title": "Rodapé - Segurança",
      "blockClass": "footer-seal-group",
      "preventVerticalStretch": true
    },
    "children": ["rich-text#footer-security-title", "image#footer-selo-seguranca"]
  },

  "rich-text#footer-security-title": {
    "props": {
      "title": "Rodapé - Título Segurança",
      "text": "Segurança",
      "blockClass": "footer-seal-title"
    }
  },

  "image#footer-selo-seguranca": {
    "props": {
      "title": "Rodapé - Selo VTEX / PCI",
      "src": "assets/imgs/footer/selo-seguranca.png",
      "alt": "Site seguro — VTEX e PCI Certified",
      "width": "66",
      "height": "41",
      "blockClass": "footer-seal-badge"
    }
  },

  "flex-layout.col#footer-payment": {
    "props": {
      "title": "Rodapé - Formas de Pagamento",
      "blockClass": "footer-seal-group",
