{
  "footer": {
    "blocks": ["footer-layout.desktop", "footer-layout.mobile"]
  },

  "footer-layout.desktop": {
    "children": [
      "flex-layout.row#newsletter",
      "flex-layout.row#footer-brand",
      "flex-layout.row#footer-menus",
      "flex-layout.row#footer-legal"
    ]
  },

  "footer-layout.mobile": {
    "children": [
      "flex-layout.row#newsletter",
      "flex-layout.row#footer-mobile"
    ]
  },

  "flex-layout.row#footer-mobile": {
    "props": {
      "title": "Rodapé - Conteúdo (Mobile)",
      "blockClass": "footer-mobile-row",
      "fullWidth": true,
      "preventHorizontalStretch": true,
      "preventVerticalStretch": true
    },
    "children": ["flex-layout.col#footer-mobile"]
  },

  "flex-layout.col#footer-mobile": {
    "props": {
      "title": "Rodapé - Colunas (Mobile)",
      "blockClass": "footer-mobile",
      "preventVerticalStretch": true
    },
    "children": [
      "flex-layout.row#footer-logo",
      "flex-layout.col#footer-accordions",
      "flex-layout.col#footer-security",
      "flex-layout.col#footer-payment",
      "flex-layout.col#footer-app",
      "flex-layout.col#footer-social",
      "flex-layout.row#footer-legal"
    ]
  },

  "flex-layout.row#footer-brand": {
    "props": {
      "title": "Rodapé - Logo e Selos",
      "blockClass": "footer-brand",
      "fullWidth": true,
      "preventHorizontalStretch": true,
      "preventVerticalStretch": true
    },
    "children": ["flex-layout.row#footer-logo", "flex-layout.row#footer-seals"]
  },

  "flex-layout.row#footer-logo": {
    "props": {
      "title": "Rodapé - Logo",
      "blockClass": "footer-logo",
      "preventHorizontalStretch": true,
      "preventVerticalStretch": true
    },
    "children": ["logo#footer"]
  },

  "logo#footer": {
    "props": {
      "title": "Rodapé - Logo Drogaria São Pedro",
      "href": "/",
      "url": "assets/imgs/logo-desktop.png",
      "width": "278",
      "height": "62",
      "blockClass": "footer"
    }
  },

  "flex-layout.row#footer-seals": {
    "props": {
      "title": "Rodapé - Selos",
      "blockClass": "footer-seals",
      "preventHorizontalStretch": true,
      "preventVerticalStretch": true
    },
    "children": [
      "flex-layout.col#footer-security",
      "flex-layout.col#footer-payment",
      "flex-layout.col#footer-app",
      "flex-layout.col#footer-social"
    ]
  },

  "flex-layout.row#footer-menus": {
    "props": {
      "title": "Rodapé - Menus",
      "blockClass": "footer-menus",
      "fullWidth": true,
      "preventHorizontalStretch": true,
      "preventVerticalStretch": true
    },
    "children": [
      "flex-layout.col#footer-menu-institucional",
      "flex-layout.col#footer-menu-servicos",
      "flex-layout.col#footer-menu-atendimento",
      "flex-layout.col#footer-menu-privacidade"
    ]
  },

  "flex-layout.row#footer-legal": {
    "props": {
      "title": "Rodapé - Rodapé Legal",
      "blockClass": "footer-legal",
      "fullWidth": true,
      "preventHorizontalStretch": true,
      "preventVerticalStretch": true
    },
    "children": ["rich-text#footer-copyright", "rich-text#footer-tech"]
  },

  "rich-text#footer-copyright": {
    "props": {
      "title": "Rodapé - Texto Legal",
      "text": "Lorem ipsum dolor sit amet, consetetur sadipscing elitr, sed diam",
      "blockClass": "footer-copyright"
    }
  },

  "rich-text#footer-tech": {
    "props": {
      "title": "Rodapé - Assinatura Tecnologia",
      "text": "Tecnologia: **LOGO RESULTATE**",
      "blockClass": "footer-tech"
    }
  }
}
