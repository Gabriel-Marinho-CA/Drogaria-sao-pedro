{
  /* ─────────────────────────────────────────────────────────────
     Prateleiras da home — Figma cards: node 1-3131 | desktop: 1-5470
     | mobile: 1-11363

     O `showcase-shelf` é um bloco React de
     drogariasaopedro.custom-components (react/ShowcaseShelf.tsx). Ele é
     autossuficiente: busca a coleção sozinho (vtex.search-graphql) e desenha
     cada produto com o ShowcaseCard, o card do Figma feito naquele app.

     Ou seja, não há mais `list-context.product-list`, nem `rich-text` de
     título, nem `product-summary.shelf` aqui — coleção, título e layout são
     props do bloco. O card da busca e da PDP continua sendo o
     `product-summary.shelf` de product-summary/product-summary.jsonc, que não
     foi tocado.

     O `flex-layout.row` continua por fora só como caixa da seção: é ele que
     dá o container (gutters e largura máxima) e o espaçamento vertical de
     .flexRowContent--showcase.

     Estilo: nada aqui é vestido por CSS handle do tema. O visual do carrossel
     e do card vive no CSS Module do app
     (react/components/showcase/showcase.css).
     ───────────────────────────────────────────────────────────── */

  // ─────────────────────────────────────────────────────────────
  // Showcase — Destaques da Semana
  // ─────────────────────────────────────────────────────────────
  "flex-layout.row#showcase": {
    "title": "Prateleira - Destaques da Semana",
    "props": {
      "blockClass": "showcase"
    },
    "children": [
      "showcase-shelf#showcase"
    ]
  },
  "showcase-shelf#showcase": {
    "title": "Carrossel - Destaques da Semana",
    "props": {
      "title": "Destaques da Semana",
      // Substitua pelo ID da coleção desejada no VTEX Catalog.
      // Provisório: vazio, a busca vai sem filtro e o `orderBy` sozinho
      // decide — a prateleira sobe com os mais vendidos em vez de ficar vazia.
      "collection": "",
      "orderBy": "OrderByTopSaleDESC",
      "maxItems": 12,
      "itemsPerPage": {
        "desktop": 5,
        "tablet": 3,
        // 2 cards por vez com o terceiro espiando na borda, como no Figma mobile.
        "phone": 2.2
      },
      // o Swiper aplica o gap inline no slide, então ele vem por prop e não
      // pelo CSS. 2px = as bordas de 1px dos cards vizinhos encostando.
      "spaceBetween": 2,
      // com slidesPerView fracionado o loop desalinha a cada volta
      "infinite": false,
      "showNavigationArrows": false,
      "showPaginationDots": true
    },
    /* O coração da wishlist. O card React o renderiza por
       `ExtensionPoint id="add-to-list-btn"`, que endereça o slot pelo nome da
       interface — por isso `blocks` e não `children`.

       Não dá para importar o componente: vtex.wish-list é app com cobrança e
       só entra em peerDependencies, que compõe bloco mas não expõe módulo JS. */
    "blocks": [
      "add-to-list-btn"
    ]
  },

  // ─────────────────────────────────────────────────────────────
  // Showcase 2 — entra abaixo do minibanners-2
  // ─────────────────────────────────────────────────────────────
  "flex-layout.row#showcase-2": {
    "title": "Prateleira - Showcase 2",
    "props": {
      "blockClass": "showcase"
    },
    "children": [
      "showcase-shelf#showcase-2"
    ]
  },
  "showcase-shelf#showcase-2": {
    "title": "Carrossel - Showcase 2",
    "props": {
      "title": "Showcase 2",
      // Ver comentário em showcase-shelf#showcase
      "collection": "",
      "orderBy": "OrderByTopSaleDESC",
      "maxItems": 12,
      "itemsPerPage": {
        "desktop": 5,
        "tablet": 3,
        "phone": 2.2
      },
      "spaceBetween": 2,
      "infinite": false,
      "showNavigationArrows": false,
      "showPaginationDots": true
    },
    /* O coração da wishlist. O card React o renderiza por
       `ExtensionPoint id="add-to-list-btn"`, que endereça o slot pelo nome da
       interface — por isso `blocks` e não `children`.

       Não dá para importar o componente: vtex.wish-list é app com cobrança e
       só entra em peerDependencies, que compõe bloco mas não expõe módulo JS. */
    "blocks": [
      "add-to-list-btn"
    ]
  },

  // ─────────────────────────────────────────────────────────────
  // Showcase 3 — entra abaixo do showcase-2
  // ─────────────────────────────────────────────────────────────
  "flex-layout.row#showcase-3": {
    "title": "Prateleira - Showcase 3",
    "props": {
      "blockClass": "showcase"
    },
    "children": [
      "showcase-shelf#showcase-3"
    ]
  },
  "showcase-shelf#showcase-3": {
    "title": "Carrossel - Showcase 3",
    "props": {
      "title": "Showcase 3",
      // Ver comentário em showcase-shelf#showcase
      "collection": "",
      "orderBy": "OrderByTopSaleDESC",
      "maxItems": 12,
      "itemsPerPage": {
        "desktop": 5,
        "tablet": 3,
        "phone": 2.2
      },
      "spaceBetween": 2,
      "infinite": false,
      "showNavigationArrows": false,
      "showPaginationDots": true
    },
    /* O coração da wishlist. O card React o renderiza por
       `ExtensionPoint id="add-to-list-btn"`, que endereça o slot pelo nome da
       interface — por isso `blocks` e não `children`.

       Não dá para importar o componente: vtex.wish-list é app com cobrança e
       só entra em peerDependencies, que compõe bloco mas não expõe módulo JS. */
    "blocks": [
      "add-to-list-btn"
    ]
  },

  /* ─────────────────────────────────────────────────────────────
     Bloco antigo "Confira nossas ofertas". Não é referenciado por
     store.home (ver home.jsonc) — segue aqui só como legado.
     ───────────────────────────────────────────────────────────── */
  "flex-layout.col#showcase-confira-ofertas": {
    "props": {
      "blockClass": [
        "showcase",
        "confira-ofertas"
      ],
      "preventVerticalStretch": true
    },
    "children": [
      "flex-layout.col#title-confira-ofertas-1",
      "flex-layout.col#showcase-confira"
    ]
  },
  "flex-layout.col#title-confira-ofertas-1": {
    "props": {
      "blockClass": [
        "title-showcase",
        "title-confira-ofertas"
      ]
    },
    "children": [
      "rich-text#title-confira-ofertas-1"
    ]
  },
  "rich-text#title-confira-ofertas-1": {
    "props": {
      "text": "Confira nossas ofertas",
      "textAlignment": "CENTER",
      "textColor": "c-on-muted-6",
      "font": "t-heading-6",
      "blockClass": [
        "title-showcase",
        "confira-title"
      ]
    }
  },
  "flex-layout.col#showcase-confira": {
    "props": {
      "blockClass": [
        "showcase-col",
        "confira-showcase"
      ]
    },
    "children": [
      "list-context.product-list#home-collection-confira-ofertas-1"
    ]
  },
  "list-context.product-list#home-collection-confira-ofertas-1": {
    "props": {
      "collection": ""
    },
    "blocks": [
      "product-summary.shelf"
    ],
    "children": [
      "slider-layout#collection-slider-confira"
    ]
  },
  "slider-layout#collection-slider-confira": {
    "props": {
      "itemsPerPage": {
        "desktop": 2,
        "tablet": 2,
        "phone": 2
      },
      // "infinite": true,
      "showNavigationArrows": "never",
      "showPaginationDots": "always",
      "blockClass": [
        "collection-slider",
        "summary-showcase",
        "slider-confira"
      ]
      // "fullWidth": true
    }
  }
}
