{
    "flex-layout.row#minibanners-3": {
        "title": "Minibanners 3",
        "children": [
            "list-context.info-card-list#minibanners-3-v1"
        ],
        "props": {
            "blockClass": [
                "minibanners-2",
                "minibanners-3"
            ]
        }
    },
    "list-context.info-card-list#minibanners-3-v1": {
        "children": [
            "slider-layout#minibanners-3"
        ],
        "props": {
            "infoCards": [
                {
                    "isFullModeStyle": false,
                    "callToActionUrl": "/",
                    "imageUrl": "assets/imgs/minibanners-3-1.png",
                    "mobileImageUrl": "assets/imgs/minibanners-3-1-mob.png",
                    "imageActionUrl": "/"
                },
                {
                    "isFullModeStyle": false,
                    "callToActionUrl": "/",
                    "imageUrl": "assets/imgs/minibanners-3-2.png",
                    "mobileImageUrl": "assets/imgs/minibanners-3-2-mob.png",
                    "imageActionUrl": "/"
                },
                {
                    "isFullModeStyle": false,
                    "callToActionUrl": "/",
                    "imageUrl": "assets/imgs/minibanners-3-1.png",
                    "mobileImageUrl": "assets/imgs/minibanners-3-1-mob.png",
                    "imageActionUrl": "/"
                },
                {
                    "isFullModeStyle": false,
                    "callToActionUrl": "/",
                    "imageUrl": "assets/imgs/minibanners-3-2.png",
                    "mobileImageUrl": "assets/imgs/minibanners-3-2-mob.png",
                    "imageActionUrl": "/"
                }
            ]
        }
    },
    "slider-layout#minibanners-3": {
        "title": "Carrossel - Minibanners 3",
        "props": {
            "itemsPerPage": {
                "desktop": 2,
                "tablet": 2,
                "phone": 1
            },
            // "center" deixa o slide ativo no meio, com pedaço do anterior e do
            // proximo aparecendo dos dois lados.
            "centerMode": {
                "desktop": "disabled",
                "tablet": "disabled",
                "phone": "center"
            },
            "centerModeSlidesGap": 4,
            "infinite": false,
            "fullWidth": false,
            "showNavigationArrows": "never",
            "showPaginationDots": "always",
            "blockClass": [
                "minibanners-2",
                "minibanners-3"
            ]
        }
    }
}
